# =============================================================================
# 複製這個檔案為 .env.local 並填入實際值。詳細取得步驟見 README.md
# .env.local 已被 .gitignore 排除，不會進版控。
# =============================================================================

# --- Supabase（必填）---------------------------------------------------------
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 只在 server 端使用，用於分享連結的匿名存取。
# 絕對不要加上 NEXT_PUBLIC_ 前綴，那會把它打包進瀏覽器。
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps（選填）------------------------------------------------------
# 沒填的話：地圖區塊會顯示提示，地點改為手動輸入，其餘功能完全正常。
# Google Cloud Console → 憑證 → API 金鑰（記得設定 HTTP 參照網址限制）
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps Platform → 地圖管理 → 建立地圖 ID（類型 JavaScript、向量）
# AdvancedMarker（有編號的標記）需要這個
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- 站台 --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
